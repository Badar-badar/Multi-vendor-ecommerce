# ==============================================================================
# ZAREEN FRONTEND ENVIRONMENT CONFIGURATION (VITE)
#
# IMPORTANT SECURITY GUIDELINES:
# - Only variables prefixed with VITE_ are exposed to the client bundle.
# - NEVER store private API keys, database credentials, Stripe secret keys,
#   JWT secrets, or sensitive credentials in this file or any frontend repository.
# ==============================================================================

# Backend REST API Base Endpoint
VITE_API_URL=http://localhost:5000/api/v1

# Real-Time WebSocket / Socket.IO Server Endpoint
VITE_SOCKET_URL=http://localhost:5000

# Public / Publishable Keys (Safe for Client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_sample_key_here
